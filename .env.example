# Kopiera till .env och fyll i.

# Nyckel som krävs för API, MCP och webbgränssnittet. Skapa t.ex. med: openssl rand -hex 24
API_KEY=

# Adressen som mobilen når servern på. Används i QR-koden på bongen.
# Lämna tom för att skippa QR-koden.
PUBLIC_URL=http://192.168.1.10:8080

TZ=Europe/Stockholm
PRINT_TIME=07:00
PRINT_DAYS=mon,tue,wed,thu,fri,sat,sun
MAX_TICKETS=5

# preview = sparar bara bilder i data/tickets (bra innan skrivaren finns)
# network = skrivare med nätverkskabel/WiFi, usb = skrivare i USB-porten
PRINTER_TYPE=preview
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
# USB_VENDOR=0x04b8
# USB_PRODUCT=0x0e28

# Valfri python-escpos-profil, t.ex. TM-T20II
PRINTER_PROFILE=

# 576 för 80 mm-papper, 384 för 58 mm
PAPER_WIDTH_PX=576
